{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParaBank account response",
  "type": "object",
  "anyOf": [
    { "required": ["id"] },
    { "required": ["accountId"] }
  ],
  "properties": {
    "id": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "accountId": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "customerId": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "type": { "type": "string" },
    "balance": { "anyOf": [{ "type": "number" }, { "type": "string" }] }
  },
  "additionalProperties": true
}