{
  "name": "anz-parabank-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Cucumber and Playwright automation for ParaBank",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:web": "cross-env BROWSER=chromium MOBILE_VIEWPORT=false cucumber-js -p web",
    "test:web:crossbrowser:chromium": "cross-env BROWSER=chromium MOBILE_VIEWPORT=false cucumber-js -p web-crossbrowser-chromium",
    "test:web:crossbrowser:firefox": "cross-env BROWSER=firefox MOBILE_VIEWPORT=false cucumber-js -p web-crossbrowser-firefox",
    "test:crossbrowser": "node scripts/run-suites.js crossbrowser",
    "test:mobile": "cross-env BROWSER=chromium MOBILE_VIEWPORT=true cucumber-js -p web-mobile",
    "test:mobile:firefox": "cross-env BROWSER=firefox MOBILE_VIEWPORT=true cucumber-js -p web-mobile-firefox",
    "test:web:mobile-smoke:chromium": "npm run test:mobile",
    "test:web:mobile-smoke": "npm run test:crossbrowser",
    "test:api": "cucumber-js -p api",
    "test:accessibility": "cucumber-js -p web-accessibility",
    "test:payid": "cucumber-js -p api-payid",
    "test:all": "node scripts/run-suites.js all",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^12.2.0",
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.49.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
